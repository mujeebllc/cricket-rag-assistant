# ============================================================
# DIRECT PLAYER BATTING STATISTICS
#
# Handles:
# - How many runs has Babar Azam scored?
# - How many fours has Babar Azam hit?
# - How many sixes has Babar Azam hit?
# - How many balls has Babar Azam faced?
#
# These bypass RAG + LLM for speed and reliability.
#
# NOTE: These are aggregate career stats, so they belong to
# batting_stats (not the player table, which holds profile
# info like BattingStyle/Country/City).
# ============================================================

def generate_direct_player_stat_sql(question):

    question_lower = question.lower().strip()

    patterns = [

        # RUNS
        (r"how many runs has (.+?) scored\??$", "Runs", "TotalRuns"),
        (r"how many runs did (.+?) score\??$", "Runs", "TotalRuns"),
        (r"total runs (?:of|for) (.+?)\??$", "Runs", "TotalRuns"),

        # FOURS
        (r"how many fours has (.+?) hit\??$", "Fours", "TotalFours"),
        (r"how many fours did (.+?) hit\??$", "Fours", "TotalFours"),
        (r"total fours (?:of|for) (.+?)\??$", "Fours", "TotalFours"),

        # SIXES
        (r"how many sixes has (.+?) hit\??$", "Sixes", "TotalSixes"),
        (r"how many sixes did (.+?) hit\??$", "Sixes", "TotalSixes"),
        (r"total sixes (?:of|for) (.+?)\??$", "Sixes", "TotalSixes"),

        # BALLS FACED
        (r"how many balls has (.+?) faced\??$", "BF", "TotalBallsFaced"),
        (r"how many balls did (.+?) face\??$", "BF", "TotalBallsFaced"),
        (r"total balls (?:faced|of|for) (.+?)\??$", "BF", "TotalBallsFaced"),

        # MATCHES
        (r"how many matches has (.+?) played\??$", "Matches", "TotalMatches"),
        (r"total matches of (.+?)\??$", "Matches", "TotalMatches"),

        # INNINGS
        (r"how many innings has (.+?) played\??$", "Inn", "TotalInnings"),

        # NOT OUTS
        (r"how many times has (.+?) been not out\??$", "NotOut", "NotOuts"),

        # HIGHEST SCORE
        (r"what is (.+?)'?s highest score\??$", "HS", "HighestScore"),

        # BATTING AVERAGE
        (r"what is (.+?)'?s batting average\??$", "Average", "BattingAverage"),

        # STRIKE RATE
        (r"what is (.+?)'?s strike rate\??$", "SR", "StrikeRate"),

        # HUNDREDS
        (r"how many hundreds has (.+?) scored\??$", "Hundreds", "Hundreds"),

        # FIFTIES
        (r"how many fifties has (.+?) scored\??$", "Fifties", "Fifties"),

        # DUCKS
        (r"how many ducks has (.+?) scored\??$", "Zeros", "Ducks"),

        # CATCHES
        (r"how many catches has (.+?) taken\??$", "Catches", "Catches"),

        # STUMPINGS
        (r"how many stumpings has (.+?) made\??$", "Stumps", "Stumpings"),
    ]

    for pattern, column, alias in patterns:

        match = re.match(pattern, question_lower, re.IGNORECASE)

        if match:

            player_name = match.group(1).strip()
            player_name = player_name.rstrip("?.!")
            player_name_sql = player_name.replace("'", "''")

            if column in ["Average", "SR", "HS"]:

                sql = (
                    f"SELECT MAX(bs.{column}) AS {alias} "
                    "FROM batting_stats bs "
                    "JOIN player p "
                    "ON bs.PlayerId = p.PlayerId "
                    f"WHERE LOWER(p.FullName) = LOWER('{player_name_sql}');"
                )

            else:

                sql = (
                    f"SELECT SUM(bs.{column}) AS {alias} "
                    "FROM batting_stats bs "
                    "JOIN player p "
                    "ON bs.PlayerId = p.PlayerId "
                    f"WHERE LOWER(p.FullName) = LOWER('{player_name_sql}');"
                )

            print("\n========== DIRECT PLAYER STAT RULE ==========\n")
            print(f"Detected player: {player_name}")
            print(f"Requested field: {column}")
            print(f"Generated SQL: {sql}")
            print("\n================================================\n")

            return sql

    return None


# ============================================================
# DIRECT PLAYER LIST BY COUNTRY
# Handles:
# - List players from Pakistan
# - Show players from Pakistan
# - Which players are from Pakistan?
# ============================================================

def generate_direct_player_list_sql(question):

    question_lower = question.lower().strip()

    patterns = [
        r"list players from (.+?)\??$",
        r"show players from (.+?)\??$",
        r"which players are from (.+?)\??$",
        r"show me players from (.+?)\??$",
    ]

    for pattern in patterns:

        match = re.match(pattern, question_lower, re.IGNORECASE)

        if match:

            country_name = match.group(1).strip()
            country_name = country_name.rstrip("?.!")
            country_name_sql = country_name.replace("'", "''")

            sql = (
                "SELECT DISTINCT FullName "
                "FROM player "
                f"WHERE LOWER(Country) = LOWER('{country_name_sql}') "
                "AND FullName IS NOT NULL "
                "AND TRIM(FullName) <> '' "
                "ORDER BY FullName;"
            )

            print("\n========== DIRECT PLAYER LIST RULE ==========\n")
            print(f"Detected country: {country_name}")
            print(f"Generated SQL: {sql}")
            print("\n=============================================\n")

            return sql

    return None


