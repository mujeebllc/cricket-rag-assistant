    print("Question received:", repr(question))

    # ========================================================
    # STEP 1: DIRECT PLAYER STATISTICS
    # ========================================================

    direct_sql = generate_direct_player_stat_sql(question)

    if direct_sql:
        print("Using deterministic player-stat SQL.")
        return direct_sql

